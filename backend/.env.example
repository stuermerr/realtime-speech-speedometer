AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=replace-with-azure-api-key
AZURE_OPENAI_DEPLOYMENT=replace-with-deployment-name
DEEPGRAM_API_KEY=replace-with-deepgram-api-key
LIVE_WPM_DEBUG=false
# Optional live pace tuning. Restart the backend after changing values.
# Accepted production default:
# LIVE_WPM_MODE=single
# LIVE_WPM_WINDOW_SECONDS=5.0
# LIVE_WPM_MINIMUM_ACTIVE_SECONDS=1.0
#
# Dual Window spike profile A (opt-in only):
# LIVE_WPM_MODE=dual
# LIVE_WPM_SHORT_WINDOW_SECONDS=1.0
# LIVE_WPM_LONG_WINDOW_SECONDS=3.0
# LIVE_WPM_SHORT_WEIGHT=0.7
